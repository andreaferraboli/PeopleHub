# Configurazione del server MCP di PeopleHub sulla VPS: /etc/peoplehub-mcp/env (600, utente peoplemcp).
# Niente secret qui: la chiave del service account e il token admin sono file a parte in /etc/peoplehub-mcp
# (google-sa.json, admin-token, root 600), passati al servizio da systemd con LoadCredential.
PUBLIC_URL=https://people-mcp.2-24-13-98.sslip.io
HOST=127.0.0.1
PORT=18750
# Email Google ammesse, separate da virgola: controllate al login e a ogni richiesta /mcp. Il jolly `*` non vale.
# Dopo una modifica: systemctl restart peoplehub-mcp
ALLOWED_EMAILS=andrew.ferro04@gmail.com
FIREBASE_PROJECT_ID=peoplehub-af26
# Giorni dopo i quali va rifatto l'accesso con Google
MAX_SESSION_DAYS=30
